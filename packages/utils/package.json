{
  "name": "@cubicsui/utils",
  "description": "Package containing utility functions by Studio Cubics",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "version": "0.0.28",
  "keywords": [
    "@studiocubics",
    "cubics",
    "studio",
    "utils",
    "functions",
    "utilities"
  ],
  "author": {
    "name": "Ishfaq Ahmed",
    "email": "ishfaqahmed0837@gmail.com",
    "url": "https://studio-cubics.vercel.app"
  },
  "license": "MIT",
