{
  "name": "@cubicsui/components",
  "description": "Package containing UI components by Studio Cubics",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "version": "0.0.0",
  "keywords": [
    "@cubicsui",
    "cubics",
    "studio",
    "components",
    "ui",
    "design"
  ],
  "author": {
    "name": "Ishfaq Ahmed",
    "email": "ishfaqahmed0837@gmail.com",
    "url": "https://studio-cubics.vercel.app"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "sideEffects": true,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "clean": "rimraf dist node_modules"
  },
  "peerDependencies": {
    "react": ">= 19",
    "react-dom": ">= 19"
  },
  "dependencies": {
    "@cubicsui/hooks": "workspace:^",
    "@cubicsui/utils": "workspace:^",
    "@cubicsui/icons": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@cubicsui/tsconfig": "workspace:^",
    "@cubicsui/types": "workspace:^",
    "@tsdown/css": "^0.21.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "glob": "^13.0.6",
    "globals": "^16.5.0",
    "tsdown": "^0.21.9",
    "typescript": "^5",
    "typescript-eslint": "^8.58.1"
  }
}
